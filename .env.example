APP_ENV=development

DATABASE_URL=postgresql+psycopg://news_intelligence_app:REPLACE_WITH_A_STRONG_PASSWORD_URLENCODED_IF_SPECIAL_CHARACTERS@localhost:5432/news_intelligence

TEST_DATABASE_URL=postgresql+psycopg://news_intelligence_app:REPLACE_WITH_A_STRONG_PASSWORD_URLENCODED_IF_SPECIAL_CHARACTERS@localhost:5432/news_intelligence_test

REDIS_URL=redis://localhost:6379/0

CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_LOCK_URL=redis://localhost:6379/2

CELERY_ENDPOINT_CLAIM_TTL_SECONDS=3600
CELERY_DISPATCH_INTERVAL_SECONDS=30
CELERY_DISPATCH_LIMIT=500

# Required before any endpoint is activated on the Phase 3 acquisition path.
# These must be distinct, non-nested directories on approved local storage.
# Keep the cutover limit at one until the first Phase 3 feed passes parity review.
ARTIFACT_STAGING_ROOT=path-to/artifacts/staging
ARTIFACT_CANONICAL_ROOT=path-to/artifacts/canonical
PHASE3_FEED_CUTOVER_LIMIT=1
ACQUISITION_INTERNAL_SERVICES=[]
